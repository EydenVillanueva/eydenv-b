---
layout: sidebar.njk
title: Blog
---
<section class="page-header">
  <h1>Blog</h1>
  <p class="page-subtitle">Notas y artículos sobre desarrollo de software.</p>
</section>

<div class="tag-filters" role="group" aria-label="Filtrar por tema">
  <button type="button" class="tag-filter active" data-tag="all">Todos</button>
  {%- for tag in collections.postTags %}
  <button type="button" class="tag-filter" data-tag="{{ tag }}">#{{ tag }}</button>
  {%- endfor %}
</div>

<div class="search-box">
  <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <circle cx="11" cy="11" r="8"></circle>
    <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
  </svg>
  <input type="search" id="post-search" placeholder="Buscar en {{ collections.post.length }} artículos..." aria-label="Buscar artículos">
</div>

<p class="no-results" hidden>No se encontraron artículos.</p>

<div class="post-groups">
  {%- for group in collections.post | groupByYear %}
  <section class="post-year-group">
    <h2>{{ group.year }} <span class="count-pill">{{ group.posts.length }} {{ "artículo" if group.posts.length == 1 else "artículos" }}</span></h2>
    <ul class="post-list">
      {%- for post in group.posts %}
      <li class="post-item" data-tags="{{ post.data.tags | join(',') }}" data-title="{{ post.data.title | lower }}">
        <span class="post-date">{{ post.date | readableDate }}</span>
        <a class="post-list-title" href="{{ post.url }}">{{ post.data.title }}</a>
        {% if post.data.description %}<p>{{ post.data.description }}</p>{% endif %}
        <div class="post-tags">
          {%- for tag in post.data.tags %}{% if tag != "post" %}<span class="post-tag">#{{ tag }}</span>{% endif %}{% endfor -%}
        </div>
      </li>
      {%- endfor %}
    </ul>
  </section>
  {%- endfor %}
</div>
